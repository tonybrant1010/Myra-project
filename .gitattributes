# Git attribútumok

# PDF-ek binárisként (ne próbálja szövegként diffelni/konvertálni).
*.pdf binary

# Sorvégződés: a szerverre kerülő fájlok LF-fel záródjanak, Windows-on is. CRLF-fel a
# shebang (#!/bin/bash) és a változók " \r" végződést kapnak, ami a szerveren hibát okoz
# ("bad interpreter", "$'\r': command not found").
*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ini     text eol=lf
*.conf    text eol=lf
*.md      text eol=lf

# A Windows-os parancsfájlok maradjanak CRLF-esek.
*.bat     text eol=crlf
*.cmd     text eol=crlf
