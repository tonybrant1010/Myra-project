[Unit]
Description=llama.cpp server - router mod (Myra)
After=network-online.target

[Service]
User=antalodor
EnvironmentFile=/etc/llama-server.env
ExecStart=/home/antalodor/llama.cpp/build/bin/llama-server --models-preset /home/antalodor/llm/models.ini --models-max 3 --host 0.0.0.0 --port 8080 --api-key ${LLAMA_API_KEY}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
